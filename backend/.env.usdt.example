# USDT 支付配置模板
# 复制此文件为 .env 并填写实际值

# ==================== TRC20 配置 ====================
# TRC20 收款地址（必填）
USDT_TRC20_DEPOSIT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# TRC20 合约地址（USDT 官方合约，一般不需要修改）
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# TronGrid API 配置（注册地址：https://www.trongrid.io/）
USDT_TRC20_API_URL=https://api.trongrid.io
USDT_TRC20_API_KEY=your-trongrid-api-key-here

# HMAC 密钥（32字节以上随机字符串，用于生成唯一金额）
# 生成方式：openssl rand -hex 32
USDT_TRC20_HMAC_SECRET=your-32-byte-hmac-secret-key-here-please-change-me

# 轮询间隔（秒，默认15）
USDT_TRC20_POLL_INTERVAL=15

# 确认数要求（默认19）
USDT_TRC20_CONFIRMATIONS=19

# ==================== ERC20 配置（可选）====================
# ERC20 收款地址
USDT_ERC20_DEPOSIT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7

# ERC20 合约地址（USDT 官方合约）
USDT_ERC20_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7

# Etherscan API 配置（注册地址：https://etherscan.io/apis）
USDT_ERC20_API_URL=https://api.etherscan.io
USDT_ERC20_API_KEY=your-etherscan-api-key-here

# HMAC 密钥
USDT_ERC20_HMAC_SECRET=your-32-byte-hmac-secret-key-here-please-change-me

# 轮询间隔（秒，默认30）
USDT_ERC20_POLL_INTERVAL=30

# 确认数要求（默认12）
USDT_ERC20_CONFIRMATIONS=12

# ==================== 监控服务控制 ====================
# 禁用自动监控（设置为1则只能手动查询）
# BLOCKCHAIN_MONITOR_DISABLED=1

# ==================== 测试网配置（开发环境）====================
# 使用 Shasta 测试网（TRC20）
# USDT_TRC20_API_URL=https://api.shasta.trongrid.io
# USDT_TRC20_DEPOSIT_ADDRESS=your-shasta-test-address

# 使用 Sepolia 测试网（ERC20）
# USDT_ERC20_API_URL=https://api-sepolia.etherscan.io
# USDT_ERC20_DEPOSIT_ADDRESS=your-sepolia-test-address
